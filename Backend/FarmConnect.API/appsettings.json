{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=FarmConnectDb;Trusted_Connection=true;",
    "FirebaseConnection": "YOUR_FIREBASE_CONNECTION_STRING"
  },
  "Jwt": {
    "SecretKey": "your-super-secret-jwt-key-change-in-production",
    "Issuer": "FarmConnect",
    "Audience": "FarmConnectUsers",
    "ExpirationMinutes": 60
  },
  "Firebase": {
    "Type": "service_account",
    "ProjectId": "your-firebase-project-id",
    "PrivateKeyId": "your-private-key-id",
    "PrivateKey": "your-private-key",
    "ClientEmail": "your-client-email",
    "ClientId": "your-client-id",
    "AuthUri": "https://accounts.google.com/o/oauth2/auth",
    "TokenUri": "https://oauth2.googleapis.com/token",
    "AuthProviderX509CertUrl": "https://www.googleapis.com/oauth2/v1/certs"
  },
  "OpenAI": {
    "ApiKey": "your-openai-api-key",
    "OrganizationId": "your-org-id"
  },
  "WeatherAPI": {
    "ApiKey": "your-openweathermap-api-key",
    "BaseUrl": "https://api.openweathermap.org"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000",
      "https://farmconnect.com"
    ]
  },
  "SignalR": {
    "Enabled": true,
    "MaximumReceiveMessageSize": 65536
  }
}
